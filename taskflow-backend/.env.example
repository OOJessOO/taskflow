# Variables locales (optionnelles — en production, Render injecte DATABASE_URL
# directement, le fichier .env n'est pas utilisé).
PORT=5000

# Connexion PostgreSQL locale (alternative à DATABASE_URL)
DB_NAME=taskflow
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# En production : copier la connection string Neon ici.
# DATABASE_URL=postgresql://user:password@host:port/dbname?sslmode=require

JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
